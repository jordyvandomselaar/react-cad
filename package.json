{
  "name": "react-cad-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm --filter @jordyvd/react-cad build && pnpm --filter @jordyvd/react-cad-render build",
    "dev": "node packages/react-cad-render/bin/react-cad-render.mjs examples/basic/design.tsx",
    "smoke": "node packages/react-cad-render/bin/react-cad-render.mjs examples/basic/design.tsx --smoke",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
